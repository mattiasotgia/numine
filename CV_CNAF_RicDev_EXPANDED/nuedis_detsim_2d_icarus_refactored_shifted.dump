#
icarus_opticalproperties: @local::icarus_opticalproperties_202401patch

END_PROLOG



BEGIN_PROLOG


#
# Standard ICARUS configuration
#
# Use as:
#     
#     services.LArPropertiesService: @local::icarus_properties
#     
icarus_properties: {

    @table::standard_properties # from `larproperties.fcl` (`lardata`)

    @table::icarus_opticalproperties # from `opticalproperties_icarus.fcl`

} # icarus_properties

#
#
#

END_PROLOG

BEGIN_PROLOG

standard_detproperties :
{
 service_provider: "DetectorPropertiesServiceStandard"

 # Drift properties 
 Temperature:      91                #Kelvin
 Efield:           [0.5,0.66,0.8 ]   #kV/cm
 Electronlifetime: 750               #microseconds
 
 SternheimerA:     0.1956  # Ar Sternheimer parameter a.
 SternheimerK:     3.0000  # Ar Sternheimer parameter k.
 SternheimerX0:    0.2000  # Ar Sternheimer parameter x0.
 SternheimerX1:    3.0000  # Ar Sternheimer parameter x0.
 SternheimerCbar:  5.2146  # Ar Sternheimer parameter Cbar.

 DriftVelFudgeFactor: 1.

 UseIcarusMicrobooneDriftModel: false # if true, use alternative drift velocity formulation

 # Historically, ConvertTicksToX has allowed for the drift time between the
 # wire planes. This is appropriate for recob::RawDigits, and recob::Wires from
 # the 1D unfolding, but is not appropriate for recob::Wires from WireCell. The
 # default value is 'true', retaining the 'classic' behaviour.
 IncludeInterPlanePitchInXTickOffsets: true

 ElectronsToADC:    1.208041e-3  # in ADC/e; 6241.5 electrons = 1fC = 7.54 ADC counts for ArgoNeuT
 NumberTimeSamples: 2048         # ticks of the clock per readout frame
 TimeOffsetU:       -5.193
 TimeOffsetV:       0.585
 TimeOffsetZ:       0
 ReadOutWindowSize: 2048

 SimpleBoundaryProcess: true  #enable opticalBoundaryProcessSimple instead of G4 default

}

# be sure to make the necessary changes when microboone and
# lbne have different electronics simulations from argoneut

END_PROLOG

BEGIN_PROLOG

icarus_detproperties: {
  @table::standard_detproperties

  ElectronsToADC:            1.208041e-3     # in ADC/e; 6241.5 electrons = 1fC
  Temperature:               87.5
  Electronlifetime:          3000            # As agreed 3/17/22 to match measured value in East croystat
  # Active volume E-field calculated based on SBN-doc-23259 (H. Carranza and Z. Williams) using Vp = 75150 (from M. Mooney)
  Efield:                    [0.4938,0.733,0.933 ] #kV/cm to first,second,third wire planes

  # Set this true to use the non-default "ICARUS+MicroBooNE" calcultaion for drift velocity
  UseIcarusMicrobooneDriftModel: true

  SternheimerA:              0.1956           # Ar Sternheimer parameter a.
  SternheimerK:              3.0000           # Ar Sternheimer parameter k.
  SternheimerX0:             0.2000           # Ar Sternheimer parameter x0.
  SternheimerX1:             3.0000           # Ar Sternheimer parameter x0.
  SternheimerCbar:           5.2146           # Ar Sternheimer parameter Cbar.

  DriftVelFudgeFactor: 0.99733

  NumberTimeSamples:         4096
  TimeOffsetU:               0.
  TimeOffsetV:               0.
  TimeOffsetY:               0.
  TimeOffsetZ:               0.
  ReadOutWindowSize:         4096
  InheritNumberTimeSamples:  true

  SimpleBoundaryProcess:     false # relevant only when using full Optical simulation

  IncludeInterPlanePitchInXTickOffsets: false # removed by deconvolution

} // icarus_detproperties

END_PROLOG
#
# File:    detectorclocks_icarus.fcl
# Purpose: Configuration of DetectorClocks service for ICARUS.
#
# Available configurations:
#
# * `icarus_detectorclocks`: standard ICARUS configuration
# * `icarus_detectorclocks+data_notiming`: readout all at the same time
#
#


BEGIN_PROLOG


#
# Standard ICARUS configuration
#
# Use as:
#     
#     services.DetectorClocksService: @local::icarus_detectorclocks
#     
#
icarus_detectorclocks: {
    service_provider: "DetectorClocksServiceStandard"

    TrigModuleName:    "daqTrigger"
    InheritClockConfig: true
    G4RefTime:        -1.5e3  # G4 time [us] where electronics clock counting start
    TriggerOffsetTPC: -0.340e3 # Time offset for TPC readout start time w.r.t. trigger [us]
    FramePeriod:       1638.4  # Frame period [us]; 4096 * 400 ns
    ClockSpeedTPC:     2.5     # TPC clock speed in MHz;
    ClockSpeedOptical: 500     # Optical clock speed in MHz
    ClockSpeedTrigger: 16      # Trigger clock speed in MHz
    ClockSpeedExternal:31.25   # External clock speed in MHz
    DefaultTrigTime:   1.5e3  # Default trigger time in electronics clock [us]
    DefaultBeamTime:   1.5e3  # Default beam gate time in electronics clock [us]
    
} # icarus_detectorclocks


# ##############################################################################
#
# Data read out all at the same time
#
# Use as:
#     
#     services.DetectorClocksService: @local::icarus_detectorclocks_data_notiming
#     
#
icarus_detectorclocks_data_notiming: {
    @table::icarus_detectorclocks

    InheritClockConfig: false
    G4RefTime:              0.0   # G4 time [us] where electronics clock counting start
    TriggerOffsetTPC:       0.0   # Time offset for TPC readout start time w.r.t. trigger [us]
    DefaultTrigTime:        0.0   # Default trigger time in electronics clock [us]
    DefaultBeamTime:        0.0   # Default beam gate time in electronics clock [us]
    
} # icarus_detectorclocks_data_notiming

#
#
#

END_PROLOG


BEGIN_PROLOG


################################################################################
###  icarus_basic_services
###
#
# Standard ICARUS configuration of basic services, including message service,
# art services, geometry and properties, but not calibration services.
#
icarus_basic_services:
{
    message:                             @local::icarus_message_services_interactive # from `messages_icarus.fcl`

                                         @table::icarus_geometry_services

    DetectorPropertiesService:           @local::icarus_detproperties  # from `detectorproperties_icarus.fcl`
    LArPropertiesService:                @local::icarus_properties     # from `larproperties_icarus.fcl`
    DetectorClocksService:               @local::icarus_detectorclocks # from `detectorclocks_icarus.fcl`

} # icarus_basic_services


END_PROLOG


BEGIN_PROLOG


FieldResponseTool:
{
    tool_type:                FieldResponse
    Plane:                    0
    ResponseType:             0
    SignalType:               0
    FieldResponseFileName:    "t600_response"
    FieldResponseFileVersion: "v0.0"
    FieldResponseHistName:    "t600_response"
    FieldResponseAmplitude:   1.
    TimeCorrectionFactor:     1000. 
}

ElectronicsResponseTool:
{
    tool_type:                ElectronicsResponse
    Plane:                    0
    FCperADCMicroS:           0.0321  # Scaling to match data, from electronics tests it was 0.027
    ASICShapingTime:          1.3
    ADCPerPCAtLowestASICGain: 5500.
}

ElectronicsResponseBesselApproxTool:
{
    tool_type:                ElectronicsResponseBesselApprox
    Plane:                    0
    FCperADCMicroS:           0.0321  # Scaling to match data, from electronics tests it was 0.027
    ASICShapingTime:          1.3
    ADCPerPCAtLowestASICGain: 5500.
    TimeOffset:               0.0 # note that 1.625 will produce a plot that matches electronics paper
                                  # unfortunately, that leads to a time offset in the response we'd rather not have
}

FilterTool:
{
    tool_type: Filter
    Plane:                       0
    #-----------------------------------------------------------------------------
    #************* THIS BLOCK CONTAINS HISTORICAL CONFIGURATIONS *****************
    # This is the original Wiener filter
    #FilterFunction:               "(x>0.0)? (gaus(0)*exp(-0.5*pow(x/[3],[4]))): 0.0"
    #FilterParametersVec:          [ 1.849030, 1.46, 1.33, 0.23, 4.89 ]
    # This defines the gaussian filter
    #FilterFunction:              "(x>0.0)*gaus"
    #FilterParametersVec:         [1., 0., 0.1 ]  # Offset and sigma are MHz by the way the filter is constructed
    #-----------------------------------------------------------------------------
    # For MCC1.1 we use the following filter for all three planes
    # The filter function is a mating of two gaussians to provide both low and high frequency filtering
    # Note that as of release v08_00_00 the parameters are in units of MHz
    FilterFunction:              "(x>0.0) ? ((1. - gaus(0)) * gaus(3)) : 0.0"
    FilterParametersVec:         [1., 0., 4.0,   1., 0., 100.]
    FilterWidthCorrectionFactor: 1.0
}

ResponseTool:
{
    tool_type: Response
    Plane:               0
    Correction3D:        1.
    TimeScaleFactor:     1.
    UseEmpiricalOffsets: true
    FieldResponse:       @local::FieldResponseTool
    ElectronicsResponse: @local::ElectronicsResponseBesselApproxTool
    Filter:              @local::FilterTool
}

icarus_signalshapingservice:
{
    PlaneForNormalization: 2
    PrintResponses:        "false"
    DeconNorm:             1.
    InitialFFTSize:        4096
                           # Setting the default scaling as per Justin Mueller study (3/17/22)
    NoiseFactVec:          [ [ 1.151, 1.151, 1.151, 1.151 ], [ 1.152, 1.152, 1.152, 1.152], [ 1.096, 1.096, 1.096, 1.096 ] ]
    StoreHistograms:       true

    ResponseTools:
    {
        ResponsePlane0: @local::ResponseTool
        ResponsePlane1: @local::ResponseTool
        ResponsePlane2: @local::ResponseTool
    }
}

icarus_signalshapingservice.ResponseTools.ResponsePlane0.Plane:                       0
icarus_signalshapingservice.ResponseTools.ResponsePlane0.FieldResponse.Plane:         0
icarus_signalshapingservice.ResponseTools.ResponsePlane0.FieldResponse.SignalType:    0
icarus_signalshapingservice.ResponseTools.ResponsePlane0.ElectronicsResponse.Plane:   0
icarus_signalshapingservice.ResponseTools.ResponsePlane0.Filter.Plane:                0

icarus_signalshapingservice.ResponseTools.ResponsePlane1.Plane:                       1
icarus_signalshapingservice.ResponseTools.ResponsePlane1.FieldResponse.Plane:         1
icarus_signalshapingservice.ResponseTools.ResponsePlane1.FieldResponse.ResponseType:  1
icarus_signalshapingservice.ResponseTools.ResponsePlane1.FieldResponse.SignalType:    0
icarus_signalshapingservice.ResponseTools.ResponsePlane1.ElectronicsResponse.Plane:   1
icarus_signalshapingservice.ResponseTools.ResponsePlane1.Filter.Plane:                1

icarus_signalshapingservice.ResponseTools.ResponsePlane2.Plane:                       2
icarus_signalshapingservice.ResponseTools.ResponsePlane2.FieldResponse.Plane:         2
icarus_signalshapingservice.ResponseTools.ResponsePlane2.FieldResponse.ResponseType:  2
icarus_signalshapingservice.ResponseTools.ResponsePlane2.FieldResponse.SignalType:    1
icarus_signalshapingservice.ResponseTools.ResponsePlane2.ElectronicsResponse.Plane:   2
icarus_signalshapingservice.ResponseTools.ResponsePlane2.Filter.Plane:                2
icarus_signalshapingservice.ResponseTools.ResponsePlane2.Filter.FilterFunction:       "(x>0.0) ? gaus(0) : 0.0"
icarus_signalshapingservice.ResponseTools.ResponsePlane2.Filter.FilterParametersVec:  [ 1., 0.0, 100. ]

END_PROLOG
#
