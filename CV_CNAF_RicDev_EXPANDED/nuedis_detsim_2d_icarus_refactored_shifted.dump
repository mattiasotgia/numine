# File:    calibration_database_PMT_TagSets_icarus.fcl
# Author:  M. Vicenzi (mvicenzi@bnl.gov), J. Kim (jae.sung.kim.3426@gmail.com)
# Date:    February 20, 2025
# Purpose: Tags definitions for the PMT timing calibration databases

BEGIN_PROLOG

# These are the standard tags for analyses on Run 1 data
# These tagged versions of the databases only contain tables relevant for Run 1
PMT_CalibrationTags_Run1: {
  pmt_cables_delays_data:    "v1r0"  # tables for run>=0 (null) and run>=8046
  pmt_laser_timing_data:     "v1r0"  # tables for run>=0 (null) and run>=8046
  pmt_cosmics_timing_data:   "v1r0"  # tables for run>=0 (null) and run>=8046 
}

# These are the standard tags for analyses on Run 1 and Run 2 data (as of August 2023)
# These tagged versions of the databases contain tables relevant for Run 1 and Run 2.
# Notes: 
#  - No cosmics corrections are available for Run 2
#  - Laser and cable corrections do not cover the entire Run 2 period
PMT_CalibrationTags_Run2_August2023: {
  pmt_cables_delays_data:    "v2r0"  # tables for run>=0 (null), run>=8046 and run>=9773
  pmt_laser_timing_data:     "v2r0"  # tables for run>=0 (null), run>=8046 and run>=9773
  pmt_cosmics_timing_data:   "v1r0"  # tables for run>=0 (null) and run>=8046 
}

# These are the standard tags for analyses on Run 1 and Run 2 data (as of September 2023)
# These tagged versions of the databases contain tables relevant for Run 1 and Run 2.
# Notes: 
#  - No cosmics corrections are available for Run 2
PMT_CalibrationTags_Run2_Sept2023: {
  pmt_cables_delays_data:    "v2r1"  # tables for run>=0 (null), run>=8046, run>=9301, run>=9628 and run>=9773
  pmt_laser_timing_data:     "v2r1"  # tables for run>=0 (null), run>=8046, run>=9301, run>=9628 and run>=9773
  pmt_cosmics_timing_data:   "v2r0"  # tables for run>=0 (null), run>=8046 and run>=9301 (null) 
}

# These are the standard tags for analyses on Run 1 and Run 2 data (as of December 2023)
# These tagged versions of the databases contain tables relevant for Run 1 and Run 2.
# Notes: 
#  - Updated cable delays with new phase offsets
#  - Full laser and cosmics corrections for all Run 2.
PMT_CalibrationTags_Run2_Dec2023: {
  pmt_cables_delays_data:    "v2r3"  # tables for run>=0 (null), run>=8046, run>=9301, run>=9628, run>=9773 and run>=10369
  pmt_laser_timing_data:     "v2r1"  # tables for run>=0 (null), run>=8046, run>=9301, run>=9628 and run>=9773
  pmt_cosmics_timing_data:   "v2r1"  # tables for run>=0 (null), run>=8046, run>=9301, run>=9628 and run>=9773 
}

# These are the standard tags for analyses on Run 1, Run 2 and pre-Run 3 data (as of December 2023)
# These tagged versions of the databases contain tables relevant for Run 1, Run 2 and pre-Run 3.
# Notes: 
#   - New cable delays (mapping changes, upgrades to laser distribution)
#   - New laser table for the beginning of Run 3 (new signal cables)
PMT_CalibrationTags_Run3_Dec2023: {
  pmt_cables_delays_data:    "v2r4"  # tables for run>=0 (null), run>=8046, run>=9301, run>=9628, run>=9773, run>=10369 and run>=10865
  pmt_laser_timing_data:     "v2r2"  # tables for run>=0 (null), run>=8046, run>=9301, run>=9628, run>=9773 and run>=10908
  pmt_cosmics_timing_data:   "v2r1"  # tables for run>=0 (null), run>=8046, run>=9301, run>=9628 and run>=9773 
}

# These are the standard tags for analyses on Run 1, Run 2, Run 3 and pre-Run 4 data (as of Feb 2025)
# These tagged versions of the databases contain tables relevant for Run 1, Run 2, Run 3 and pre-Run 4.
# Notes: 
#   - New cable delays for Run 4 (after summer 2024 laser and PPS changes)
#   - New laser tables up to final Run 4 gain equalization
#   - New cosmics corrections for Run 3, updates to Run 1,2 tables (more statistics)
PMT_CalibrationTags_Run3_Feb2025: {
  pmt_cables_delays_data:    "v2r5"  # tables for run>=0 (null)
                                     # Run 1: run>=8046
                                     # Run 2: run>=9301, run>=9628, run>=9773
                                     # Run 3: run>=10369, run>=10441, run>=10865
                                     # Run 4: run>=12040, run>=12455, run>=12777
  pmt_laser_timing_data:     "v2r3"  # tables for run>=0 (null)
                                     # Run 1: run>=8046
                                     # Run 2: run>=9301, run>=9628, run>=9773
                                     # Run 3: run>=10908, run>=11590
                                     # Run 4: run>=12058, run>=12837
  pmt_cosmics_timing_data:   "v2r2"  # tables for run>=0 (null)
                                     # Run 1: run>=8046
                                     # Run 2: run>=9301, run>=9628, run>=9773
                                     # Run 3: run>=11590
}

END_PROLOG
# File:    calibration_database_GlobalTags.fcl
# Purpose: Collection of tag info for the TPC calibration database

BEGIN_PROLOG

## Valid for Run A,1, and 2
## - Files decoded with release <v09_66_02 should use v3r1 
TPC_CalibrationTags_Oct2023: {

  tpc_channelstatus_data: "v3r1"
  tpc_elifetime_data: "v2r1"
  tpc_dqdxcalibration_data: "v2r1"
  tpc_yz_correction_data: "v2r1"

}

## Valid for Run A,1, and 2
## - tpc_channelstatus_data updated to v3r2, where we reverted back "flange=WE20M AND board=1 or 5" to "Good" status.
## - Files decoded with release >=v09_66_02 should use v3r2
TPC_CalibrationTags_Feb2024: {

  tpc_channelstatus_data: "v3r4"
  tpc_elifetime_data: "v2r1"
  tpc_dqdxcalibration_data: "v2r1"
  tpc_yz_correction_data: "v2r1"

}

## TPC_CalibrationTags_Feb2024 but updating tpc_yz_correction_data to tpc_yz_correction_allplanes_data
TPC_CalibrationTags_Jan2025: {

  tpc_channelstatus_data: "v3r2"
  tpc_elifetime_data: "v2r1"
  tpc_dqdxcalibration_data: "v2r1"
  tpc_yz_correction_allplanes_data: "v1r0"

}

END_PROLOG
# File:    calibration_database_GlobalTags.fcl
# Purpose: Collection of tag info for the TPC calibration database

BEGIN_PROLOG

## Valid for Run A,1, and 2
CRT_CalibrationTags_Oct2023: {

  crt_gain_reco_data: "v1r0"

}

END_PROLOG

BEGIN_PROLOG

ICARUS_Calibration_GlobalTags: {
  @table::TPC_CalibrationTags_Jan2025
  @table::PMT_CalibrationTags_Run3_Feb2025
  @table::CRT_CalibrationTags_Oct2023
}


END_PROLOG

BEGIN_PROLOG

icarus_siov_channelstatus_service: @local::standard_siov_channelstatus_service

icarus_siov_channelstatus_service.service_provider:                                        SIOVChannelStatusICARUSService
icarus_siov_channelstatus_service.ChannelStatusProvider.DatabaseRetrievalAlg.DBFolderName: "tpc_channelstatus_data"
icarus_siov_channelstatus_service.ChannelStatusProvider.DatabaseRetrievalAlg.DBTag:        @local::ICARUS_Calibration_GlobalTags.tpc_channelstatus_data
icarus_siov_channelstatus_service.ChannelStatusProvider.DatabaseRetrievalAlg.DBUrl:        "https://dbdata0vm.fnal.gov:9443/icarus_con_prod/app/"
icarus_siov_channelstatus_service.ChannelStatusProvider.DatabaseRetrievalAlg.UseSQLite:    true
icarus_siov_channelstatus_service.ChannelStatusProvider.UseDB:                             true

END_PROLOG


BEGIN_PROLOG

# ##############################################################################
# ChannelStatusService: noisy and dead channels
# ------------------------------------------------------------------------------
#
# This configuration declare the channels all good.
#
# Use as:
#    
#    services.ChannelStatusService: @local::icarus_channelstatusservice
#    
# In the below, "standard" means no DB and a perfect Detector
# Change this to "icarus" to access the channel status DB
icarus_channelstatusservice: @local::icarus_siov_channelstatus_service # from `database_standard.fcl` (`larevt`)


# ##############################################################################
# DetPedestalService: TPC wire pedestal access
# ------------------------------------------------------------------------------
# the default implementation with default  configuration has no database access,
# and returns a fixed value no matter what.
# We could override that value here.
#
#Use as:
#    
#    services.DetPedestalService: @local::icarus_detpedestalservice
#
icarus_detpedestalservice: {

  @table::standard_siov_detpedestal_service # from `database_standard.fcl` (`larevt`)

  # DefaultCollMean: 400
  # DefaultIndMean: 2048
  
} # icarus_detpedestalservice


# ##############################################################################
# Configuration preset: enables all calibration services
#
icarus_calibration_services: {
  
  DetPedestalService:             @local::icarus_detpedestalservice
  ChannelStatusService:           @local::icarus_channelstatusservice
  # ElectronicsCalibService:        @local::icarus_electronicscalib_service

} # icarus_calibration_services:


# ##############################################################################

END_PROLOG

#
# File:    sam_icarus.fcl
# Purpose: Configuration for SAM database (metadata)
# Version: 1.1
#
# Changes:
# 20160721 (petrillo@fnal.gov) [v1.1]
#   added "extra" configuration
#
#

BEGIN_PROLOG

# Standard configurations for art's built-in FileCatalogMetadata service.
# Metadata fields are standard, but values are still icarus-specific.
art_file_catalog:
{
  # Note sam application name is taken from "process_name" fcl parameter in main job file.
  #applicationFamily:   "art"
  #applicationVersion:  "v08_37_00"
  group:               "icarus"
  fileType:            "unknown"
  runType:             "physics"
}


art_file_catalog_mc:           @local::art_file_catalog
art_file_catalog_mc.fileType:  "mc"

art_file_catalog_data:           @local::art_file_catalog
art_file_catalog_data.fileType:  "data"

art_file_catalog_tfile:
{
  JSONFileName:          "tfile.json"
  GenerateTFileMetadata: true
  dataTier:              "root-tuple"
  fileFormat:            "root"
}

END_PROLOG

BEGIN_PROLOG


################################################################################
###  icarus_art_services
###
#
# A set of basic art services you never want to be without.
# Includes:
#  * resource monitoring (`TimeTracker`, `MemoryTracker`)
#  * message facility, with interactive (non-debug) configuration
#
# Although you may want to use different message facility service settings.
#
icarus_art_services: {

  scheduler:   { defaultExceptions: false }    # Make all uncaught exceptions fatal.

  message:     @local::icarus_basic_services.message # from `services_basic_icarus.fcl`

  TimeTracker: {
    printSummary: true
    dbOutput: {
      filename:  "TimingReport.db"
      overwrite: true
    }
  }
  MemoryTracker: {
    dbOutput: {
      filename:  "MemoryReport.db"
      overwrite: true
    }
  }

  DuplicateEventTracker: {}

} # icarus_art_services


################################################################################
###  icarus_random_services
###
#
# Standard ICARUS configuration of random number related services.
#
icarus_random_services:
{
    RandomNumberGenerator:               {}
    NuRandomService:                     @local::icarus_default_NuRandomService  # seedservice_icarus.fcl

} # icarus_random_services


################################################################################
###  icarus_minimum_services
###
#
# Standard ICARUS configuration of the minimum needed services, including
# message service, art services, geometry and properties,
# but not calibration services.
#
icarus_minimum_services:
{
    @table::icarus_art_services

    # Load the service that manages root files for histograms.
    TFileService:                        { fileName: "Supplemental-%ifb_%tc-%p.root" }

    FileCatalogMetadata:                 @local::art_file_catalog_mc

                                         @table::icarus_basic_services

} # icarus_common_services


################################################################################
###  icarus_common_services
###
#
# Standard ICARUS configuration of common services, including message service,
# art services, geometry and properties, but not calibration services.
#
icarus_common_services:
{
    @table::icarus_minimum_services

    @table::icarus_random_services

} # icarus_common_services


################################################################################
###  icarus_wirecalibration_minimum_services
###
#
# Standard ICARUS configuration of services required for wire signal calibration
# (usually the first step of reconstruction).
#
icarus_wirecalibration_minimum_services: {

                                    @table::icarus_minimum_services

    SignalShapingICARUSService:     @local::icarus_signalshapingservice

                                    @table::icarus_calibration_services

} # icarus_wirecalibration_minimum_services


################################################################################
###  icarus_wirecalibration_services
###
#
# Standard ICARUS configuration of services required for wire signal calibration
# (usually the first step of reconstruction).
#
icarus_wirecalibration_services: {

                     @table::icarus_wirecalibration_minimum_services

                     @table::icarus_random_services

} # icarus_wirecalibration_services


################################################################################

icarus_prod_services: {
                       @table::icarus_common_services
  FileCatalogMetadata: @local::art_file_catalog_mc
} # icarus_prod_services

END_PROLOG


#
# File:    calibrations_icarus.fcl
# Purpose: Configuration for services delivering calibration information.
# Date:    August 9th, 2018
# Author:  Gianluca Petrillo (petrillo@fslac.stanford.edu)
#
# Included configurations:
# * `icarus_channelstatusservice`: standard ICARUS `ChannelStatusService`
# * `icarus_detpedestalservice`: standard ICARUS `DetPedestalService`
#
# Included presets:
# * `icarus_calibration_services`: incudes all the calibration services
#
#

#
# File:    database_icarus.fcl
# Purpose: Configuration for services delivering database related information.
# Date:    March 7, 2023
# Author:  Gianluca Petrillo (petrillo@fslac.stanford.edu) <== we'll blame him
#
# Included configurations:
# * `icarus_channelstatusservice`: standard ICARUS `ChannelStatusService`
# * `icarus_detpedestalservice`: standard ICARUS `DetPedestalService`
#
# Included presets:
# * `icarus_calibration_services`: incudes all the calibration services
#
#

BEGIN_PROLOG

standard_databaseretrievalalg:
{
  AlgName: "DatabaseRetrievalAlg"
  DBFolderName:  ""
  DBUrl: ""
  DBTag: ""
}



standard_pedestalretrievalalg:
{
    AlgName:            "DetPedestalRetrievalAlg"
    DatabaseRetrievalAlg: @local::standard_databaseretrievalalg
    
    UseDB: false
    UseFile: false
    
    DefaultCollMean: 400.0
    DefaultCollRms:  0.3
    DefaultIndMean:  2048.0
    DefaultIndRms:   0.3
    DefaultMeanErr:  0.0
    DefaultRmsErr:   0.0
}

standard_siov_detpedestal_service:
{
  service_provider: SIOVDetPedestalService
  DetPedestalRetrievalAlg: @local::standard_pedestalretrievalalg
}



standard_siov_channelstatus_provider:
{
  AlgName:       "SIOVChannelStatusProvider"
  DatabaseRetrievalAlg: @local::standard_databaseretrievalalg
  
  UseDB: false
  UseFile: false
}

standard_siov_channelstatus_service:
{
  service_provider: SIOVChannelStatusService
  ChannelStatusProvider: @local::standard_siov_channelstatus_provider 
}

END_PROLOG
# File:    calibration_database_PMT_TagSets_icarus.fcl
# Author:  M. Vicenzi (mvicenzi@bnl.gov), J. Kim (jae.sung.kim.3426@gmail.com)
# Date:    February 20, 2025
# Purpose: Tags definitions for the PMT timing calibration databases

BEGIN_PROLOG

# These are the standard tags for analyses on Run 1 data
# These tagged versions of the databases only contain tables relevant for Run 1
PMT_CalibrationTags_Run1: {
  pmt_cables_delays_data:    "v1r0"  # tables for run>=0 (null) and run>=8046
  pmt_laser_timing_data:     "v1r0"  # tables for run>=0 (null) and run>=8046
  pmt_cosmics_timing_data:   "v1r0"  # tables for run>=0 (null) and run>=8046 
}

# These are the standard tags for analyses on Run 1 and Run 2 data (as of August 2023)
# These tagged versions of the databases contain tables relevant for Run 1 and Run 2.
# Notes: 
#  - No cosmics corrections are available for Run 2
#  - Laser and cable corrections do not cover the entire Run 2 period
PMT_CalibrationTags_Run2_August2023: {
  pmt_cables_delays_data:    "v2r0"  # tables for run>=0 (null), run>=8046 and run>=9773
  pmt_laser_timing_data:     "v2r0"  # tables for run>=0 (null), run>=8046 and run>=9773
  pmt_cosmics_timing_data:   "v1r0"  # tables for run>=0 (null) and run>=8046 
}

# These are the standard tags for analyses on Run 1 and Run 2 data (as of September 2023)
# These tagged versions of the databases contain tables relevant for Run 1 and Run 2.
# Notes: 
#  - No cosmics corrections are available for Run 2
PMT_CalibrationTags_Run2_Sept2023: {
  pmt_cables_delays_data:    "v2r1"  # tables for run>=0 (null), run>=8046, run>=9301, run>=9628 and run>=9773
  pmt_laser_timing_data:     "v2r1"  # tables for run>=0 (null), run>=8046, run>=9301, run>=9628 and run>=9773
  pmt_cosmics_timing_data:   "v2r0"  # tables for run>=0 (null), run>=8046 and run>=9301 (null) 
}

# These are the standard tags for analyses on Run 1 and Run 2 data (as of December 2023)
# These tagged versions of the databases contain tables relevant for Run 1 and Run 2.
# Notes: 
#  - Updated cable delays with new phase offsets
#  - Full laser and cosmics corrections for all Run 2.
PMT_CalibrationTags_Run2_Dec2023: {
  pmt_cables_delays_data:    "v2r3"  # tables for run>=0 (null), run>=8046, run>=9301, run>=9628, run>=9773 and run>=10369
  pmt_laser_timing_data:     "v2r1"  # tables for run>=0 (null), run>=8046, run>=9301, run>=9628 and run>=9773
  pmt_cosmics_timing_data:   "v2r1"  # tables for run>=0 (null), run>=8046, run>=9301, run>=9628 and run>=9773 
}

# These are the standard tags for analyses on Run 1, Run 2 and pre-Run 3 data (as of December 2023)
# These tagged versions of the databases contain tables relevant for Run 1, Run 2 and pre-Run 3.
# Notes: 
#   - New cable delays (mapping changes, upgrades to laser distribution)
#   - New laser table for the beginning of Run 3 (new signal cables)
PMT_CalibrationTags_Run3_Dec2023: {
  pmt_cables_delays_data:    "v2r4"  # tables for run>=0 (null), run>=8046, run>=9301, run>=9628, run>=9773, run>=10369 and run>=10865
  pmt_laser_timing_data:     "v2r2"  # tables for run>=0 (null), run>=8046, run>=9301, run>=9628, run>=9773 and run>=10908
  pmt_cosmics_timing_data:   "v2r1"  # tables for run>=0 (null), run>=8046, run>=9301, run>=9628 and run>=9773 
}

# These are the standard tags for analyses on Run 1, Run 2, Run 3 and pre-Run 4 data (as of Feb 2025)
# These tagged versions of the databases contain tables relevant for Run 1, Run 2, Run 3 and pre-Run 4.
# Notes: 
#   - New cable delays for Run 4 (after summer 2024 laser and PPS changes)
#   - New laser tables up to final Run 4 gain equalization
#   - New cosmics corrections for Run 3, updates to Run 1,2 tables (more statistics)
PMT_CalibrationTags_Run3_Feb2025: {
  pmt_cables_delays_data:    "v2r5"  # tables for run>=0 (null)
                                     # Run 1: run>=8046
                                     # Run 2: run>=9301, run>=9628, run>=9773
                                     # Run 3: run>=10369, run>=10441, run>=10865
                                     # Run 4: run>=12040, run>=12455, run>=12777
  pmt_laser_timing_data:     "v2r3"  # tables for run>=0 (null)
                                     # Run 1: run>=8046
                                     # Run 2: run>=9301, run>=9628, run>=9773
                                     # Run 3: run>=10908, run>=11590
                                     # Run 4: run>=12058, run>=12837
  pmt_cosmics_timing_data:   "v2r2"  # tables for run>=0 (null)
                                     # Run 1: run>=8046
                                     # Run 2: run>=9301, run>=9628, run>=9773
                                     # Run 3: run>=11590
}

END_PROLOG
# File:    calibration_database_GlobalTags.fcl
# Purpose: Collection of tag info for the TPC calibration database

BEGIN_PROLOG

## Valid for Run A,1, and 2
## - Files decoded with release <v09_66_02 should use v3r1 
TPC_CalibrationTags_Oct2023: {

  tpc_channelstatus_data: "v3r1"
  tpc_elifetime_data: "v2r1"
  tpc_dqdxcalibration_data: "v2r1"
  tpc_yz_correction_data: "v2r1"

}

## Valid for Run A,1, and 2
## - tpc_channelstatus_data updated to v3r2, where we reverted back "flange=WE20M AND board=1 or 5" to "Good" status.
## - Files decoded with release >=v09_66_02 should use v3r2
TPC_CalibrationTags_Feb2024: {

  tpc_channelstatus_data: "v3r4"
  tpc_elifetime_data: "v2r1"
  tpc_dqdxcalibration_data: "v2r1"
  tpc_yz_correction_data: "v2r1"

}

## TPC_CalibrationTags_Feb2024 but updating tpc_yz_correction_data to tpc_yz_correction_allplanes_data
TPC_CalibrationTags_Jan2025: {

  tpc_channelstatus_data: "v3r2"
  tpc_elifetime_data: "v2r1"
  tpc_dqdxcalibration_data: "v2r1"
  tpc_yz_correction_allplanes_data: "v1r0"

}

END_PROLOG
# File:    calibration_database_GlobalTags.fcl
# Purpose: Collection of tag info for the TPC calibration database

BEGIN_PROLOG

## Valid for Run A,1, and 2
CRT_CalibrationTags_Oct2023: {

  crt_gain_reco_data: "v1r0"

}

END_PROLOG

BEGIN_PROLOG

ICARUS_Calibration_GlobalTags: {
  @table::TPC_CalibrationTags_Jan2025
  @table::PMT_CalibrationTags_Run3_Feb2025
  @table::CRT_CalibrationTags_Oct2023
}


END_PROLOG

BEGIN_PROLOG

icarus_siov_channelstatus_service: @local::standard_siov_channelstatus_service

icarus_siov_channelstatus_service.service_provider:                                        SIOVChannelStatusICARUSService
icarus_siov_channelstatus_service.ChannelStatusProvider.DatabaseRetrievalAlg.DBFolderName: "tpc_channelstatus_data"
icarus_siov_channelstatus_service.ChannelStatusProvider.DatabaseRetrievalAlg.DBTag:        @local::ICARUS_Calibration_GlobalTags.tpc_channelstatus_data
icarus_siov_channelstatus_service.ChannelStatusProvider.DatabaseRetrievalAlg.DBUrl:        "https://dbdata0vm.fnal.gov:9443/icarus_con_prod/app/"
icarus_siov_channelstatus_service.ChannelStatusProvider.DatabaseRetrievalAlg.UseSQLite:    true
icarus_siov_channelstatus_service.ChannelStatusProvider.UseDB:                             true

END_PROLOG


BEGIN_PROLOG

# ##############################################################################
# ChannelStatusService: noisy and dead channels
# ------------------------------------------------------------------------------
#
# This configuration declare the channels all good.
#
# Use as:
#    
#    services.ChannelStatusService: @local::icarus_channelstatusservice
#    
# In the below, "standard" means no DB and a perfect Detector
# Change this to "icarus" to access the channel status DB
icarus_channelstatusservice: @local::icarus_siov_channelstatus_service # from `database_standard.fcl` (`larevt`)


# ##############################################################################
# DetPedestalService: TPC wire pedestal access
# ------------------------------------------------------------------------------
# the default implementation with default  configuration has no database access,
# and returns a fixed value no matter what.
# We could override that value here.
#
#Use as:
#    
#    services.DetPedestalService: @local::icarus_detpedestalservice
#
icarus_detpedestalservice: {

  @table::standard_siov_detpedestal_service # from `database_standard.fcl` (`larevt`)

  # DefaultCollMean: 400
  # DefaultIndMean: 2048
  
} # icarus_detpedestalservice


# ##############################################################################
# Configuration preset: enables all calibration services
#
icarus_calibration_services: {
  
  DetPedestalService:             @local::icarus_detpedestalservice
  ChannelStatusService:           @local::icarus_channelstatusservice
  # ElectronicsCalibService:        @local::icarus_electronicscalib_service

} # icarus_calibration_services:


# ##############################################################################

END_PROLOG

BEGIN_PROLOG


FieldResponseTool:
{
    tool_type:                FieldResponse
    Plane:                    0
    ResponseType:             0
    SignalType:               0
    FieldResponseFileName:    "t600_response"
    FieldResponseFileVersion: "v0.0"
    FieldResponseHistName:    "t600_response"
    FieldResponseAmplitude:   1.
    TimeCorrectionFactor:     1000. 
}

ElectronicsResponseTool:
{
    tool_type:                ElectronicsResponse
    Plane:                    0
    FCperADCMicroS:           0.0321  # Scaling to match data, from electronics tests it was 0.027
    ASICShapingTime:          1.3
    ADCPerPCAtLowestASICGain: 5500.
}

ElectronicsResponseBesselApproxTool:
{
    tool_type:                ElectronicsResponseBesselApprox
    Plane:                    0
    FCperADCMicroS:           0.0321  # Scaling to match data, from electronics tests it was 0.027
    ASICShapingTime:          1.3
    ADCPerPCAtLowestASICGain: 5500.
    TimeOffset:               0.0 # note that 1.625 will produce a plot that matches electronics paper
                                  # unfortunately, that leads to a time offset in the response we'd rather not have
}

FilterTool:
{
    tool_type: Filter
    Plane:                       0
    #-----------------------------------------------------------------------------
    #************* THIS BLOCK CONTAINS HISTORICAL CONFIGURATIONS *****************
    # This is the original Wiener filter
    #FilterFunction:               "(x>0.0)? (gaus(0)*exp(-0.5*pow(x/[3],[4]))): 0.0"
    #FilterParametersVec:          [ 1.849030, 1.46, 1.33, 0.23, 4.89 ]
    # This defines the gaussian filter
    #FilterFunction:              "(x>0.0)*gaus"
    #FilterParametersVec:         [1., 0., 0.1 ]  # Offset and sigma are MHz by the way the filter is constructed
    #-----------------------------------------------------------------------------
    # For MCC1.1 we use the following filter for all three planes
    # The filter function is a mating of two gaussians to provide both low and high frequency filtering
    # Note that as of release v08_00_00 the parameters are in units of MHz
    FilterFunction:              "(x>0.0) ? ((1. - gaus(0)) * gaus(3)) : 0.0"
    FilterParametersVec:         [1., 0., 4.0,   1., 0., 100.]
    FilterWidthCorrectionFactor: 1.0
}

ResponseTool:
{
    tool_type: Response
    Plane:               0
    Correction3D:        1.
    TimeScaleFactor:     1.
    UseEmpiricalOffsets: true
    FieldResponse:       @local::FieldResponseTool
    ElectronicsResponse: @local::ElectronicsResponseBesselApproxTool
    Filter:              @local::FilterTool
}

icarus_signalshapingservice:
{
    PlaneForNormalization: 2
    PrintResponses:        "false"
    DeconNorm:             1.
    InitialFFTSize:        4096
                           # Setting the default scaling as per Justin Mueller study (3/17/22)
    NoiseFactVec:          [ [ 1.151, 1.151, 1.151, 1.151 ], [ 1.152, 1.152, 1.152, 1.152], [ 1.096, 1.096, 1.096, 1.096 ] ]
    StoreHistograms:       true

    ResponseTools:
    {
        ResponsePlane0: @local::ResponseTool
        ResponsePlane1: @local::ResponseTool
        ResponsePlane2: @local::ResponseTool
    }
}

icarus_signalshapingservice.ResponseTools.ResponsePlane0.Plane:                       0
icarus_signalshapingservice.ResponseTools.ResponsePlane0.FieldResponse.Plane:         0
icarus_signalshapingservice.ResponseTools.ResponsePlane0.FieldResponse.SignalType:    0
icarus_signalshapingservice.ResponseTools.ResponsePlane0.ElectronicsResponse.Plane:   0
icarus_signalshapingservice.ResponseTools.ResponsePlane0.Filter.Plane:                0

icarus_signalshapingservice.ResponseTools.ResponsePlane1.Plane:                       1
icarus_signalshapingservice.ResponseTools.ResponsePlane1.FieldResponse.Plane:         1
icarus_signalshapingservice.ResponseTools.ResponsePlane1.FieldResponse.ResponseType:  1
icarus_signalshapingservice.ResponseTools.ResponsePlane1.FieldResponse.SignalType:    0
icarus_signalshapingservice.ResponseTools.ResponsePlane1.ElectronicsResponse.Plane:   1
icarus_signalshapingservice.ResponseTools.ResponsePlane1.Filter.Plane:                1

icarus_signalshapingservice.ResponseTools.ResponsePlane2.Plane:                       2
icarus_signalshapingservice.ResponseTools.ResponsePlane2.FieldResponse.Plane:         2
icarus_signalshapingservice.ResponseTools.ResponsePlane2.FieldResponse.ResponseType:  2
icarus_signalshapingservice.ResponseTools.ResponsePlane2.FieldResponse.SignalType:    1
icarus_signalshapingservice.ResponseTools.ResponsePlane2.ElectronicsResponse.Plane:   2
icarus_signalshapingservice.ResponseTools.ResponsePlane2.Filter.Plane:                2
icarus_signalshapingservice.ResponseTools.ResponsePlane2.Filter.FilterFunction:       "(x>0.0) ? gaus(0) : 0.0"
icarus_signalshapingservice.ResponseTools.ResponsePlane2.Filter.FilterParametersVec:  [ 1., 0.0, 100. ]

END_PROLOG
#
# File:    photpropservices_icarus.fcl
# Purpose: Configuration of services related to the optical detectors.
#
# Currently provides:
# * `icarus_photonvisibilityservice`: default configuration of
#     `PhotonVisibilityService` used in higher level standard scripts
#     (defined at the bottom of this configuration file)
# * `icarus_photonvisibilityservice_icarus_v2`: legacy configuration
#     for use with geometry `icarus_v2`
#     (e.g. `icarus_geometry_services_legacy_icarus_v2`)
# * `icarus_photonvisibilityservice_direct`: configuration of
#     `PhotonVisibilityService` using a photon visibility library and no mapping
# * `icarus_photonvisibilityservice_mapped`: configuration of
#     `PhotonVisibilityService` using a single cryostat photon visibility
#     library and a mapping
# * `icarus_photonvisibilityservice_mapped_oldPMTmap`: configuration of
#     `PhotonVisibilityService` using a single cryostat photon visibility
#     library and a library mapping, for use with the old PMT channel mapping
# * `icarus_photonvisibilityservice_2018`: configuration of
#     `PhotonVisibilityService` using the photon library tagged 20180801
#     library and a library mapping, for use with the old PMT channel mapping
#


# Contains information required for:
# Timing parameterisation for VUV photons (propagation time)

BEGIN_PROLOG

