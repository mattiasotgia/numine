BEGIN_PROLOG
	
icarus_simpmt: 
{
  module_type:               "SimPMTIcarus"
  InputModule:               "pdfastsim"
  
  @table::icarus_pmtsimulationalg_standard
}


icarus_simpmt_nonoise: {
  @table::icarus_simpmt
