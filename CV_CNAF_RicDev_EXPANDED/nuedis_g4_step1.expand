    0.0242526 , 0.0242526 , 0.086063   , 0.101552  , 0.134787  , 0.171863  , 0.152519  , 0.203461  , # 0   cm...
    0.224872  , 0.279135  , 0.304123   , 0.317034  , 0.341433  , 0.360053  , 0.382877  , 0.391287    # 200 cm...
  ]
