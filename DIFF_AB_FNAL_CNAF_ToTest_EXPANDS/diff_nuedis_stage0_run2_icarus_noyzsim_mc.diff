+  
+  tool_type: SampledWaveformFunctionTool
+  
+  WaveformData: "Responses/SPR202202.txt"
+  TransitTime:  "55.1 ns"
+  Gain:          @local::icarus_settings_opdet.nominalPMTgain
+  
+} # icarus_photoelectronresponse_202202
+
+
+#
+# Custom photoelectron response.
