-                                     # Run 2: run>=9301, run>=9628, run>=9773
-                                     # Run 3: run>=10908, run>=11590
-                                     # Run 4: run>=12058, run>=12837
-  pmt_cosmics_timing_data:   "v2r3"  # tables for run>=0 (null)
-                                     # Run 1: run>=8046
-                                     # Run 2: run>=9301, run>=9628, run>=9773
-                                     # Run 3: run>=11590
-                                     # Run 4: run>=12837
