   module_type: "NuGraphInferenceTriton"
}

CPUNuGraphTriton: @local::NuGraphTriton
CPUNuGraphTriton.TritonConfig.modelName: "nugraph2_cpu"

ApptainerNuGraphTriton: @local::NuGraphTriton
